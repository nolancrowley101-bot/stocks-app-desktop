{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: HTTP to stocks-services.com, native notifications, link opening.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://stocks-services.com/*" },
        { "url": "http://localhost:3000/*" }
      ]
    }
  ]
}
